{
  "name": "@local-hosting/comms",
  "packageManager": "yarn@4.18.1",
  "version": "0.3.0",
  "description": "Comms bearer catalog (payload, bitrate, range, ops) for frames and modeler.",
  "type": "module",
  "license": "MPL-2.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./catalog.json": "./dist/catalog.json",
    "./tags.json": "./dist/tags.json",
    "./aliases.json": "./dist/aliases.json",
    "./stack.json": "./dist/stack.json",
    "./schema/comms-profile.schema.json": "./schema/comms-profile.schema.json",
    "./schema/geography-registry.yml": "./schema/geography-registry.yml",
    "./profiles/*": "./profiles/*",
    "./profiles/*/*": "./profiles/*/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "profiles",
    "schema",
    "README.md"
  ],
  "scripts": {
    "validate": "node scripts/build.mjs --validate-only",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "yarn build",
    "test": "vitest run",
    "pretest": "yarn build",
    "prepack": "yarn build",
    "prepare": "yarn build",
    "ci": "yarn validate && yarn build && yarn test"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
